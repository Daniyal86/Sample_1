{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/main", "destination": "/index.html" },
    { "source": "/main.html", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
